# Copy to .env and fill in. .env is gitignored.

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model ids are chosen by measured precision per dollar (EVAL.md) and recorded in DECISIONS.md
CF_MODEL_EXTRACT=thinkingmachines/inkling-2-mini
CF_MODEL_VERIFY=deepseek/deepseek-v4.1-flash
CF_VERIFY_REASONING_TOKENS=0   # 0 = reasoning off (Nemotron ignored caps; see DECISIONS.md)
CF_MODEL_REASON=thinkingmachines/inkling-2-small
CF_LLM_BUDGET_USD=20

# Hugging Face: https://huggingface.co/settings/tokens (write scope, needed only for dataset push)
# Optional if you are already logged in with `hf auth login` (cached token)
HF_TOKEN=
HF_DATASET_REPO=

# Crawler etiquette
CF_USER_AGENT=connected-frontiers-research-crawler/0.1
CF_RATE_LIMIT_SECONDS=2
